# このファイルを .env にコピーして使う。
# .env は .gitignore に入れてある。実キーは絶対にコミットしない。

# ── PostgreSQL ──
POSTGRES_USER=dm
POSTGRES_PASSWORD=変更すること
POSTGRES_PORT=55432

# ── MinIO（開発用。本番は Cloudflare R2 に差し替え） ──
MINIO_USER=dm_minio
MINIO_PASSWORD=変更すること
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001

# ── 各サービスのポート ──
API_PORT=58080
WEB_PORT=53000

# 画面（Rails）から見た API の宛先。
#
# 空なら compose の api コンテナを指す（docker compose --profile app up）。
# Go を手元で直しながら Mac 側で go run するときだけ、次を有効にする。
#   API_BASE=http://host.docker.internal:58080
API_BASE=

# ── Google Cloud Vision（第5段階で使う） ──
# サービスアカウントのJSONへのパス。ファイル自体もリポジトリに置かない。
GOOGLE_APPLICATION_CREDENTIALS=

# ── Stripe（第8段階で使う。テストモードのみ） ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cloudflare R2（本番用。開発中は空でよい） ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Google Cloud Vision（OCRの精度優先エンジン）──
# 顧問先の ocr_engine を 'vision' にすると使われる。
# 空のままなら Tesseract（ローカル完結）のみで動く。
# キーは Google Cloud Console → 認証情報 → APIキー で作成し、
# 「Cloud Vision API のみ」に制限すること。
GOOGLE_VISION_API_KEY=
# 1ページあたりの費用（円）。空なら既定値 0.22
VISION_COST_PER_PAGE_YEN=
